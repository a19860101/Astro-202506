---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from '../components/Hero.astro'
import Card from "../components/Card.astro";

const allPosts = Object.values(import.meta.glob('./blog/posts/*.md', {eager:true}))


const heroImg = '/images/hero.jpg'
---
<BaseLayout pageTitle="首頁">
	<Hero img={heroImg}></Hero>
	<section class="grid grid-cols-2 gap-5">
		{
			allPosts.map((post:any) => <Card url={post.url} data={post.frontmatter}></Card>)
		}
	</section>
</BaseLayout>
