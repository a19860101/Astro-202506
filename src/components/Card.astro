---
import {fade, slide} from "astro:transitions";
const {url, data, idx} = Astro.props
---
<div class="border border-slate-300 rounded-xl overflow-hidden" transition:animate={slide({duration:`${idx*.5}s`})}>
    <div class="aspect-video ">
        <img src={data.hero.src} alt={data.hero.alt} class="w-full h-full object-cover">
    </div>
    <div class="flex flex-col gap-4 p-4">
        <h3 class="text-xl font-bold">{data.title}</h3>
        <div>
            <div class="text-sm">發布日期:{data.pubDate.slice(0,10)}</div>
            <div class="text-sm">作者:{data.author}</div>
        </div>
        <div>{data.tags.toString()}</div>
        <a href={url}>繼續閱讀</a>
    </div>
</div>